{
  "name": "threatlinx-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate:auth": "npx auth@latest migrate --config lib/auth.ts",
    "db:generate:auth": "npx auth@latest generate --config lib/auth.ts",
    "db:generate": "drizzle-kit generate",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate:product": "node scripts/migrate-product.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:migrate:intelligence": "node scripts/migrate-intelligence.mjs",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy": "hardhat ignition deploy ignition/modules/ThreatReportRegistry.ts --network baseSepolia",
    "test:unit": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.0.0",
    "@xyflow/react": "^12.0.0",
    "better-auth": "^1.4.0",
    "drizzle-orm": "^0.45.4",
    "inngest": "^4.26.2",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.1.0",
    "pg": "^8.13.0",
    "protobufjs": "^7.6.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tldts": "^7.0.0",
    "viem": "^2.39.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^16.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.1.0",
    "hardhat": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.2"
  },
  "type": "module"
}
